# Database connection (PostgreSQL)
# For local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/testturf?schema=public"

# For SQLite local development (if using SQLite):
# DATABASE_URL="file:./dev.db"

# JWT Secret for Auth & WebSocket handshake
JWT_SECRET="testturf-super-secret-jwt-key-2026"

# HTTP Backend Port
PORT=3001

# WebSocket Backend Port
WS_PORT=8080

# CORS Origin
CORS_ORIGIN="*"

# Node Environment
NODE_ENV="development"
